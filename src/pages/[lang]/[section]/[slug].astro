---
import ProductDetail from '../../../components/ProductDetail.astro';
import RecipeDetail from '../../../components/RecipeDetail.astro';
import { katalog, resep, langs, ROUTE } from '../../../lib/site.js';

export function getStaticPaths() {
  const produk = langs.flatMap((lang) =>
    katalog.produk.map((p) => ({
      params: { lang, section: ROUTE.produk[lang], slug: p.slug },
      props: { p },
    }))
  );
  const resepPaths = langs.flatMap((lang) =>
    resep.map((r) => ({
      params: { lang, section: ROUTE.resep[lang], slug: r.slug },
      props: { r },
    }))
  );
  return [...produk, ...resepPaths];
}

const { lang } = Astro.params;
const { p, r } = Astro.props;
---
{r ? <RecipeDetail {r} {lang} /> : <ProductDetail {p} {lang} />}
